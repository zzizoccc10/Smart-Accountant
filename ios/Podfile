# ============================================================================
# Podfile — المحاسب السهل (iOS)
# الحد الأدنى: iOS 13.0 (مطلوب لـ flutter_contacts / mobile_scanner)
# ============================================================================
platform :ios, '13.0'

# منع تفعيل مكتبات واجهة المستخدم الخاصة بـ Flutter عند البناء بدون إضافات
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # الحد الأدنى لإصدار iOS لجميع الإضافات
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # صلاحيات permission_handler — تفعيل أذونات جهات الاتصال والكاميرا والصور
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CONTACTS=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_PHONE=1',
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end

  # --------------------------------------------------------------------------
  # طبقة حماية: رقعة تلقائية لمكتبة permission_handler_apple
  # --------------------------------------------------------------------------
  # الرمز CNAuthorizationStatusLimited أُضيف في iOS 18 SDK. إذا كان Xcode
  # أقدم (iOS 17 SDK أو أقل) يفشل البناء برسالة:
  #   "Use of undeclared identifier 'CNAuthorizationStatusLimited'"
  # نُطبّق رقعة نصّية تُزيل الحالة غير المدعومة، لضمان نجاح البناء على أي Xcode.
  # --------------------------------------------------------------------------
  pod_root = File.join(installer.sandbox.root, 'permission_handler_apple')
  if File.exist?(pod_root)
    Dir.glob(File.join(pod_root, '**', '*.{m,h}')).each do |file|
      content = File.read(file)
      next unless content.include?('CNAuthorizationStatusLimited')

      patched = content.gsub(
        /^\s*case\s+CNAuthorizationStatusLimited:.*?$\n?/m,
        ''
      ).gsub(
        /^\s*case\s+CNAuthorizationStatusLimited\s*:/,
        'case CNAuthorizationStatusDenied:'
      )
      if patched != content
        File.write(file, patched)
        puts "[Podfile patch] تم إصلاح توافق iOS 18 في: #{File.basename(file)}"
      end
    end
  end
end
