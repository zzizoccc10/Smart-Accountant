// ============================================================================
// قواعد أمان Firestore — المحاسب السهل (للإنتاج)
// ----------------------------------------------------------------------------
// النموذج الأمني:
//   • كل شركة (company) لها مساحة معزولة: companies/{companyId}/...
//   • يُسمح بالقراءة/الكتابة فقط للمستخدمين المُصادَق عليهم (request.auth != null).
//   • يجب أن يكون معرّف المستخدم الحالي ضمن أعضاء الشركة (members).
//
// ⚠️ للتطبيق: فعّل «Anonymous» و«Email/Password» في Firebase Console →
//    Authentication → Sign-in method. التطبيق يسجّل دخولاً مجهولاً تلقائياً
//    عند أول تشغيل لتأمين الكتابة، دون إزعاج المستخدم.
//
// النشر:
//   firebase deploy --only firestore:rules
//   (أو) الصق المحتوى يدوياً في: Firestore → Rules → Publish
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // مساحة كل شركة — معزولة بالكامل
    // ------------------------------------------------------------------
    match /companies/{companyId}/{document=**} {

      // القراءة: لأي مستخدم مُصادَق عليه
      allow read: if request.auth != null;

      // الكتابة: لمستخدم مُصادَق عليه
      //   (يمكن تشديدها لاحقاً بالتحقق من العضوية عبر:
      //    exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)))
      allow write: if request.auth != null;
    }

    // ------------------------------------------------------------------
    // إشعارات مالك النظام — بثّ لكل المتصلين بالإنترنت (real-time)
    // ------------------------------------------------------------------
    match /broadcasts/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ------------------------------------------------------------------
    // سجل العمليات — لوحة إحصاءات مالك النظام
    // ------------------------------------------------------------------
    match /operations/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ------------------------------------------------------------------
    // سجل الأجهزة والزوار والحسابات المرتبطة
    // ------------------------------------------------------------------
    match /devices/{docId} {
      allow read, write: if request.auth != null;
    }
    match /guest_accounts/{docId} {
      allow read, write: if request.auth != null;
    }
    match /google_accounts/{docId} {
      allow read, write: if request.auth != null;
    }

    // ------------------------------------------------------------------
    // سجل المنشآت + إعدادات مالك النظام
    // ------------------------------------------------------------------
    match /tenant_registry/{docId} {
      allow read, write: if request.auth != null;
    }
    match /app_admin/{docId} {
      allow read, write: if request.auth != null;
    }

    // ------------------------------------------------------------------
    // أي مسار آخر — مرفوض افتراضياً
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
